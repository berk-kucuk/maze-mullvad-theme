# Maintainer: berkkucukk <berkkucukk@proton.me>
#
# LOCAL-BUILD PKGBUILD — see ../build-pkg.sh, which writes `pkgver` and drops
# `maze-mullvad-theme-$pkgver.tar.gz` (with the icons already rendered) next to
# this file before invoking makepkg.

pkgname=maze-mullvad-theme
pkgver=1.2.0
pkgrel=1
pkgdesc="Maze look for Mullvad VPN — black (#0b0b0b) interface and map, black-badge logo, tray icons whose helmet lamp shows the connection state"
arch=('any')
url="https://mazelinux.berkkucukk.com.tr"
license=('GPL3')
install=maze-mullvad-theme.install

# Formerly maze-mullvad-tray: installing this removes it (its restore puts
# Mullvad's files back, then this package applies over the clean copies).
replaces=('maze-mullvad-tray')
conflicts=('maze-mullvad-tray')
provides=('maze-mullvad-tray')

depends=(
    'mullvad-vpn'   # the app this themes (/usr/lib/mullvad-vpn/app.asar, hicolor icons)
    'python'        # patch_asar.py rewrites the archive
    'coreutils'
)
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$srcdir/maze-mullvad-theme-${pkgver}"

    install -Dm755 system/apply "$pkgdir/usr/lib/maze-mullvad-theme/apply"
    install -Dm755 system/restore "$pkgdir/usr/lib/maze-mullvad-theme/restore"
    install -Dm644 system/patch_asar.py "$pkgdir/usr/lib/maze-mullvad-theme/patch_asar.py"
    install -Dm644 system/theme.py "$pkgdir/usr/lib/maze-mullvad-theme/theme.py"
    install -Dm644 system/maze-mullvad-theme.hook \
        "$pkgdir/usr/share/libalpm/hooks/maze-mullvad-theme.hook"

    install -dm755 "$pkgdir/usr/share/maze-mullvad-theme/icons"
    install -m644 icons/*.png "$pkgdir/usr/share/maze-mullvad-theme/icons/"
    install -dm755 "$pkgdir/usr/share/maze-mullvad-theme/appicon"
    install -m644 appicon/*.png "$pkgdir/usr/share/maze-mullvad-theme/appicon/"

    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname/docs/images" docs/images/*.png
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
